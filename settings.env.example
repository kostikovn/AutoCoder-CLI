# --- API Configuration ---
# API Key for OpenAI or compatible providers (e.g., LM Studio, LocalAI)
OPENAI_API_KEY=your_api_key_here
# Base URL for the API provider (e.g., http://localhost:1234/v1 for LM Studio)
OPENAI_BASE_URL=http://localhost:1234/v1

# --- Model Settings ---
# The name of the model to use (e.g., gemma-4, gpt-4o, etc.)
MODEL=local-model
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.6
# Maximum tokens per response
MAX_TOKENS=262144
# Maximum number of iterations for the agent per task
MAX_ITERATIONS=200

# --- Project Configuration ---
# Absolute or relative path to the project workspace
WORKSPACE_DIR=./workspace
# System prompt to define the agent's behavior and identity
SYSTEM_PROMPT=You are a helpful assistant.
